{
  "name": "clippy-for-claude",
  "version": "0.3.2",
  "description": "A Clippy for your Mac or Windows PC that watches Claude Code and Codex sessions and lets you answer them without hunting through terminal tabs",
  "author": "AI Socratic (https://aisocratic.org)",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai-codex",
    "electron",
    "hooks",
    "macos",
    "pixel-art"
  ],
  "license": "MIT",
  "main": "src/main.js",
  "os": [
    "darwin",
    "win32"
  ],
  "engines": {
    "node": ">=18.13"
  },
  "scripts": {
    "start": "node scripts/make-buddies.js --if-missing && electron .",
    "dev": "node scripts/make-buddies.js --if-missing && node scripts/dev.js",
    "dev:once": "node scripts/make-buddies.js --if-missing && CLIPPY_DEV=1 electron .",
    "sandbox": "node scripts/demo-web.js --open /states",
    "sandbox:app": "node scripts/make-buddies.js --if-missing && CLIPPY_SANDBOX=1 electron .",
    "test": "node --test test/*.test.js",
    "test:all": "npm test && npm --prefix website test",
    "test:watch": "node --test --watch test/*.test.js",
    "check": "find bin demo scripts src test -name '*.js' -exec node --check {} \\; && node --test test/*.test.js",
    "make-buddies": "node scripts/make-buddies.js",
    "make-mobile-icons": "node scripts/make-mobile-icons.js",
    "package": "node scripts/package-app.js",
    "package:release": "node scripts/package-app.js --require-release-signing",
    "package:win": "node scripts/package-win.js",
    "package:bridge": "node scripts/prepare-bridge.js && cd vscode/clippy-bridge-ui && npx --yes @vscode/vsce@3 package --no-dependencies -o ../../dist/clippy-bridge-ui.vsix && cd ../clippy-bridge-remote && npx --yes @vscode/vsce@3 package --no-dependencies -o ../../dist/clippy-bridge-remote.vsix",
    "verify:release": "node scripts/verify-release.js",
    "add-sprite-pack": "node scripts/add-sprite-pack.js",
    "mock-session": "node scripts/mock-session.js",
    "demo:web": "node scripts/demo-web.js",
    "mobile:start": "npm --prefix mobile start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:test": "npm --prefix mobile test",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "hooks:install": "node bin/clippy-hooks.js install",
    "hooks:uninstall": "node bin/clippy-hooks.js uninstall",
    "hooks:status": "node bin/clippy-hooks.js status",
    "website": "node website/build.js && open website/index.html"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  },
  "build": {
    "appId": "dev.aisocratic.clippy",
    "productName": "Clippy for Claude Code",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "bin/**/*",
      "scripts/**/*",
      "integrations/**/*",
      "!**/*.test.js",
      "!node_modules/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Clippy-for-Claude-Code-Setup-${version}.${ext}"
    },
    "npmRebuild": false
  }
}
